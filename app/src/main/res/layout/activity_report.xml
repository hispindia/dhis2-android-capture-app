<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp">

                <!-- Left Logo -->
                <ImageView
                    android:id="@+id/headerLeftLogo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/eas"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true" />

                <!-- Center Text -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/reportTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JIMMA UNIVERSITY MEDICAL CENTER LABORATORY"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/documentNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Document No: JUMCL/MIC/F7.4-004"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/versionNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version No: 5.0"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#000000" />
                </LinearLayout>

                <!-- Right Logo -->
                <ImageView
                    android:id="@+id/headerRightLogo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/jima"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true" />
            </LinearLayout>

            <!-- Patient and Registration Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_border"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/crNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medical Record Number" />

                <TextView
                    android:id="@+id/patientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient Name" />

                <TextView
                    android:id="@+id/registrationDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registration Date" />

                <TextView
                    android:id="@+id/gender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender" />

                <TextView
                    android:id="@+id/age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOB" />
            </LinearLayout>

            <!-- Dynamic Event Boxes Container -->
            <LinearLayout
                android:id="@+id/dynamicEventContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Back"
                android:backgroundTint="@color/gray_9b9"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/printButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Print"
                android:backgroundTint="@color/blue_4fa"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
